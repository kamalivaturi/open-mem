{
  "description": "open-mem: capture tool use, summarize sessions, inject memory at start",
  "hooks": {
    "SessionStart": [{ "matcher": "startup|resume|clear|compact", "hooks": [{ "type": "command", "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/bin/open-mem.mjs\" hook", "timeout": 30 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/bin/open-mem.mjs\" hook", "timeout": 15 }] }],
    "PostToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/bin/open-mem.mjs\" hook", "timeout": 15 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/bin/open-mem.mjs\" hook", "timeout": 15 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/bin/open-mem.mjs\" hook", "timeout": 15 }] }]
  }
}
